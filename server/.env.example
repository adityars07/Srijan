PORT=5000
# PostgreSQL (Neon) — replace with your connection string
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/srijan_main?sslmode=require"
JWT_SECRET="generate-a-64-char-hex-secret"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5174"
NODE_ENV="development"

# Razorpay Standard Checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: webhook signature secret from Razorpay Dashboard
RAZORPAY_WEBHOOK_SECRET=
